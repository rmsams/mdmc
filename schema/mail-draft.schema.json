{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "title",
    "type"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "const": "mail-draft"
    },
    "message-id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending",
        "sent"
      ]
    },
    "account": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "type": "string",
      "enum": [
        "text",
        "html",
        "plain"
      ]
    },
    "subject": {
      "type": "string"
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cc": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bcc": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "in-reply-to": {
      "type": "string"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quote": {
      "type": "string",
      "enum": [
        "auto",
        "none",
        "inline"
      ]
    },
    "forward": {
      "type": "string"
    },
    "forward-attach": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "template": {
      "type": "string"
    },
    "css": {
      "type": "string"
    },
    "lua-filter": {
      "type": "string"
    },
    "link-format": {
      "type": "string",
      "enum": [
        "wikilink",
        "markdown"
      ]
    },
    "pandoc-raw": {
      "type": "boolean"
    },
    "sign": {
      "type": "boolean"
    },
    "encrypt": {
      "type": "boolean"
    },
    "tags": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    }
  }
}
