{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["title", "type", "status", "date"],
  "properties": {
    "type": { "type": "string", "const": "adr" },
    "title": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["draft", "proposed", "accepted", "superseded", "rejected"]
    },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "design": { "type": "string", "pattern": "^\\[\\[[a-z0-9_-]+\\]\\]$" }
  }
}
