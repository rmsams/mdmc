{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["title", "type", "status", "date"],
  "properties": {
    "type": { "type": "string", "const": "design-doc" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["draft", "converged"] },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "status"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "status": {
            "type": "string",
            "enum": ["open", "exploring", "leaning", "decided"]
          },
          "choice": { "type": "string" },
          "depends_on": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
          }
        }
      }
    }
  }
}
